pipeline {
    agent any 
    environment { 
         scannerHome=tool 'mysonar'
    }
    stages {
        stage ("CleanWs") {
            steps {
                cleanWs()
            }
        } 
        stage ("code") {
            steps {
                 git branch: 'main', url: 'https://github.com/naveen1694/Zomato-Repo.git'
            }
        }
        stage ("CQA") {
            steps {
                withSonarQubeEnv('mysonar') {
                sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=zomoto"
              }
            }
          }
              stage ("Quality Gates") {
                steps {
                    script {
                        waitForQualityGate abortPipeline: false, credentialsId: 'sonar-password'
                }
            }
        } 
          stage ("build") {
              steps {
                  sh 'docker build -t image1 .'
              }
          } 
          stage ("scan") {
              steps {
                  sh 'trivy image image1'
              }
          } 
          stage ("tag") {
              steps {
                  sh 'docker tag image1 naveensimhadri/devops:zomoto'
              }
          } 
          stage ("push") {
              steps {
                 script {
                     withDockerRegistry(credentialsId: 'dockerhub') { 
                         sh 'docker push naveensimhadri/devops:zomoto'
                }
              }
          }
    } 
       stage ("deploy") {
           steps {
               sh 'docker run -itd --name zomoto -p 3000:3000 naveensimhadri/devops:zomoto'
           }
       }
    }
}
